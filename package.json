{
  "name": "jinja2-visualizer",
  "displayName": "Jinja2 Visualizer",
  "description": "Visualize nested Jinja2 conditional blocks without modifying the file",
  "version": "0.0.4",
  "publisher": "mannubhai1",
  "repository": {
    "type": "git",
    "url": "https://github.com/mannubhai1/jinja2visualiser"
  },
  "categories": ["Visualization", "Other"],
  "keywords": ["jinja2", "template", "visualization", "if-else", "for"],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jinja2Visualizer.open",
        "title": "Jinja2: Open Visualizer",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "jinja2Visualizer.open",
          "when": "jinja2Visualizer.hasJinjaSyntax",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p tsconfig.test.json && node --test out-test/parser.test.js"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  }
}
